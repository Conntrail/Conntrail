# Copy this file to .env and fill in your keys.
# .env is gitignored — never commit real keys.

# Required: at least one LLM provider key, used for contrast generation
# Priority order: GROQ -> ANTHROPIC -> OPENAI -> OPENROUTER
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: OpenRouter (multi-vendor gateway, OpenAI-compatible API).
# Use model="openrouter/<vendor>/<model>" (e.g. "openrouter/anthropic/claude-3-haiku")
# to route a specific model through it.
OPENROUTER_API_KEY=

# Optional: local OpenAI-compatible inference server — Ollama, llama.cpp, vLLM,
# Unsloth Studio, or anything else speaking the OpenAI chat-completions API.
# Use model="local" or model="local/<name>" to route to it.
LOCAL_LLM_URL=http://127.0.0.1:8888/v1
LOCAL_MODEL_NAME=

# LOCAL_AUTH_MODE selects how the local server is authenticated:
#   none     (default) — no auth required (most local Ollama/llama.cpp/vLLM setups)
#   api_key  — a static bearer token, set via LOCAL_API_KEY
#   jwt      — username/password JWT exchange on every call, re-authenticated each
#              time so a server restart never causes stale-401 failures
#              (e.g. Unsloth Studio); set LOCAL_USERNAME/LOCAL_PASSWORD
LOCAL_AUTH_MODE=none
LOCAL_API_KEY=
LOCAL_USERNAME=
LOCAL_PASSWORD=

# --- Collector / dashboard deploy (Phase 6) ---

# Shared secret between the collector and any client (SDK's HttpExporter,
# the dashboard, curl). Leave blank for local/dev use — the collector then
# runs unauthenticated and logs a startup warning; set a real value before
# deploying anywhere reachable beyond localhost.
COLLECTOR_API_KEY=

# Where the SDK's HttpExporter / the dashboard reach the collector. Only
# relevant when running things individually (outside docker compose) —
# deploy/docker-compose.yml sets this itself via Docker's internal DNS
# (http://collector:8000), overriding whatever's here.
COLLECTOR_URL=http://localhost:8000

# Where the collector's sqlite file lives. deploy/Dockerfile.server sets
# this to /data/conntrail_traces.sqlite3 (a mounted volume) by default —
# only needed here for running the collector directly, outside a container.
COLLECTOR_DB_PATH=conntrail_traces.sqlite3

# Host-side port mappings for `docker compose -f deploy/docker-compose.yml up`.
COLLECTOR_HOST_PORT=8000
DASHBOARD_HOST_PORT=8001
